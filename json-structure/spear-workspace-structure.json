{
  "name": "Spear Workspace",
  "description": "Structure of a Spear workspace and its contained resources",
  "type": "object",
  "fields": [
    {"name": "id", "type": "string", "required": true, "description": "Unique workspace identifier"},
    {"name": "name", "type": "string", "required": true, "description": "Workspace name"},
    {"name": "description", "type": "string", "required": false, "description": "Workspace description"},
    {"name": "slug", "type": "string", "required": false, "description": "URL-safe identifier"},
    {"name": "visibility", "type": "enum", "values": ["private", "team", "public"], "required": false},
    {"name": "members", "type": "array<Member>", "required": false, "description": "Team members"},
    {"name": "created", "type": "date-time", "required": false, "description": "Creation timestamp"},
    {"name": "modified", "type": "date-time", "required": false, "description": "Last modified timestamp"}
  ],
  "relationships": [
    {"resource": "Collection", "cardinality": "one-to-many", "description": "API collections contained in this workspace"},
    {"resource": "Member", "cardinality": "one-to-many", "description": "Team members with workspace access"},
    {"resource": "Project", "cardinality": "one-to-many", "description": "Projects organized within the workspace"}
  ]
}
